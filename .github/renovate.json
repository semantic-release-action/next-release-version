{
  "extends": ["config:base"],
  "labels": ["dependencies"],
  "assignees": ["@ericcrosson"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "fix"
    }
  ],
  "timezone": "America/Chicago",
  "schedule": [
    "after 10pm every weekday",
    "before 5am every weekday",
    "every weekend"
  ]
}
